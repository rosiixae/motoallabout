{
  "expo": {
    "name": "MotoAllAbout",
    "slug": "motoallabout",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "motoallabout",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ch.motoallabout.app"
    },
    "android": {
      "package": "ch.motoallabout.app"
    },
    "plugins": [
      "expo-router",
      [
